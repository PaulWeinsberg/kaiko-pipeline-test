# For SSR development or preproduction environment
SSR_HOST="preview-example.dev.local"
SSR_PROTOCOL="http"

# For production or static preproduction if required
STATIC_HOST="example.dev.local"
STATIC_PROTOCOL="http"

API_KEY="my_api_key"
NODE_ENV="prod"

API_URL="http://wp.example.dev.local/wp-json/spin-api"
WP_URL="http://wp.example.dev.local"

# Media hosts. The backoffice stores and serves its media on the preview host; the static
# build syncs that bucket into the public one and rewrites the URLs accordingly, so that a
# media goes online with a deploy and not the moment it is saved in wp-admin.
MEDIA_PREVIEW_URL="http://medias-p.example.dev.local"
MEDIA_PUBLIC_URL="http://medias.example.dev.local"

GTM_ENABLE="false"
GTM_DEBUG="false"
