{
    "name": "kaiko-institutional",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "ssr:dev": "nuxt dev --hostname 0.0.0.0 -c ssr.nuxt.config.js",
        "ssr:build": "nuxt build -c ssr.nuxt.config.js",
        "ssr:serve": "nuxt start --hostname 0.0.0.0 -c ssr.nuxt.config.js",
