{
    "name": "main",
    "description": "Previously versionned in @spin-interactive/spikotify",
    "version": "2.0.3",
    "publishConfig": {
        "access": "restricted",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "lint": "npm run lint:js && npm run lint:prettier",
        "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
        "lint:prettier": "prettier --check .",
        "lint:fix": "prettier --write --list-different . && npm run lint:js --fix",
        "publish:prod": "npm publish --access protected",
        "publish:preprod": "npm publish --access protected --tag preprod",
        "publish:test": "npm publish --access protected --tag test"
    },
    "author": "Kaiko",
    "main": "module.js",
    "license": "MIT"
}
